# Server
PORT=8799
HOST=127.0.0.1

# OpenCode CLI (required for free models — free tier is CLI-only)
OPENCODE_CLI=opencode
OPENCODE_TIMEOUT_MS=120000

# Free-only policy (default ON). Set FREE_ONLY=0 to allow paid backends.
FREE_ONLY=1

# Free model rotation (comma-separated). Update when OpenCode rotates the pool.
FREE_MODELS=opencode/deepseek-v4.1-flash-free,opencode/beam-free,opencode/nemotron-3.5-lightning-free,opencode/nemotron-3.5-super-vl-free,opencode/mimo-v2.6-flash-free,opencode/flint-40b-free,opencode/big-pickle,opencode/tidepool-alpha-free,opencode/iceman-free,opencode/hy4-flash-free

# Paid backends (ignored when FREE_ONLY=1)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=ollama

# Memory
MEMORY_DB_PATH=./data/memory.sqlite
VECTOR_DIM=384

# Browser
BROWSER_HEADLESS=true
BROWSER_DATA_DIR=./data/browser

# Approvals
REQUIRE_APPROVAL_FOR=file_write,network_sensitive,commit,send,delete,purchase,mcp_tool
APPROVAL_TIMEOUT_MS=300000

# MCP security
MCP_AUDIT_LOG=./data/mcp-audit.log
# Optional allowlist (comma-separated server names)
# MCP_ALLOWED_SERVERS=filesystem,github

# Audit
AUDIT_LOG_PATH=./data/audit.log
