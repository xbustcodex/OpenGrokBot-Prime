# Server
PORT=8799
HOST=127.0.0.1

# OpenCode / free-model routing
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Optional: if you have OpenCode auth
OPENCODE_API_KEY=
# Fallback paid / stronger providers
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default free models (rotate; check live catalog)
FREE_MODELS=opencode/deepseek-v4.1-flash-free,opencode/beam-free,opencode/nemotron-3.5-lightning-free,opencode/big-pickle
ESCALATE_MODEL=openrouter/anthropic/claude-sonnet-4

# Memory
MEMORY_DB_PATH=./data/memory.sqlite
VECTOR_DIM=384

# Browser / computer sandbox
BROWSER_HEADLESS=true
BROWSER_DATA_DIR=./data/browser

# Approvals
REQUIRE_APPROVAL_FOR=file_write,network_sensitive,commit,send,delete,purchase
APPROVAL_TIMEOUT_MS=300000

# Audit
AUDIT_LOG_PATH=./data/audit.log
