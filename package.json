{
  "name": "opengrokbot-prime",
  "version": "0.1.0",
  "description": "Open-source Grok Bot alternative: multi-agent orchestration with OpenCode free-model routing, MCP, browser automation, persistent memory, approvals, and desktop UI.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "server": "tsx src/api/server.ts",
    "desktop": "electron desktop/main.js",
    "test:opencode": "tsx scripts/test-opencode.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "grok-bot",
    "multi-agent",
    "opencode",
    "mcp",
    "browser-automation",
    "self-hosted",
    "ai-agents"
  ],
  "author": "xbustcodex",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "playwright": "^1.49.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "electron": "^33.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
